{
  "id": "/tracker/",
  "name": "Verdansc Outreach",
  "short_name": "Outreach",
  "description": "Phone widget for Verdansc outreach task tracking. Marks only. Does not send.",
  "start_url": "/tracker/app.html",
  "scope": "/tracker/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0806",
  "theme_color": "#0a0806",
  "lang": "en",
  "icons": [
    {
      "src": "/tracker/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tracker/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tracker/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
